{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build QuanLyThuVien (C++11)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-Ikhaibao",
        "manguon/main.cpp",
        "manguon/menu.cpp",
        "-o",
        "QuanLyThuVien.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
