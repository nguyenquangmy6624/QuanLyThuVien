{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build QuanLyThuVien (C++11)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-Iinclude",
        "src/main.cpp",
        "src/menu.cpp",
        "src/phanquyen.cpp",
        "src/xacthuc.cpp",
        "src/luutru.cpp",
        "src/xuatcsv.cpp",
        "-o",
        "build/QuanLyThuVien.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "Create build directories"
    },
    {
      "label": "Create build directories",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path build,data,data/nhatky,data/saoluu | Out-Null"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "tests\\chaykiemthu.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}