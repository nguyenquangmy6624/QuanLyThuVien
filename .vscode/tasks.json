{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build QuanLyThuVien (C++11)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-Ikhaibao",
        "manguon/main.cpp",
        "manguon/menu.cpp",
        "-o",
        "build/QuanLyThuVien.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "Tao thu muc build"
    },
    {
      "label": "Tao thu muc build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path build | Out-Null"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}